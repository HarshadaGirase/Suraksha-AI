{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/" }],
  "headers": [
    {
      "source": "/pcm-worklet.js",
      "headers": [{ "key": "Content-Type", "value": "text/javascript" }]
    }
  ]
}
