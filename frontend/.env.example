# PUBLIC MODE only (CLAUDE.MD §6).
#
# In dev this is left unset: vite.config.js proxies /ws and /api to
# localhost:8000, so the browser sees a single origin.
#
# On Vercel set this to the deployed FastAPI backend. It MUST be wss:// — a
# page served over HTTPS cannot open a ws:// socket, the browser blocks it as
# mixed content and the connection fails with no useful error.
VITE_WS_URL=wss://your-backend.onrender.com/ws/audio
